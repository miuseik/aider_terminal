<mujoco model="world_coordinate_system">
  <option gravity="0 0 -9.81"/>
  
  <visual>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.6 0.6 0.6" specular="0 0 0"/>
    <scale forcewidth="0.01" contactwidth="0.01" contactheight="0.02"/>
    <quality shadowsize="2048"/>
  </visual>

  <worldbody>
    <!-- Ground plane -->
    <geom name="ground" type="plane" size="5 5 0.01" rgba="0.9 0.9 0.9 1"/>
    
    <!-- World Coordinate System Axes -->
    <!-- X-axis (Red) -->
    <geom name="axis_x" type="cylinder" fromto="0 0 0 1 0 0" size="0.02" rgba="1 0 0 1"/>
    <geom name="arrow_x" type="cone" fromto="1 0 0 1.2 0 0" size="0.05" rgba="1 0 0 1"/>
    
    <!-- Y-axis (Green) -->
    <geom name="axis_y" type="cylinder" fromto="0 0 0 0 1 0" size="0.02" rgba="0 1 0 1"/>
    <geom name="arrow_y" type="cone" fromto="0 1 0 0 1.2 0" size="0.05" rgba="0 1 0 1"/>
    
    <!-- Z-axis (Blue) -->
    <geom name="axis_z" type="cylinder" fromto="0 0 0 0 0 1" size="0.02" rgba="0 0 1 1"/>
    <geom name="arrow_z" type="cone" fromto="0 0 1 0 0 1.2" size="0.05" rgba="0 0 1 1"/>
    
    <!-- Origin sphere -->
    <geom name="origin" type="sphere" pos="0 0 0" size="0.05" rgba="1 1 1 1"/>
    
    <!-- A simple box to demonstrate the coordinate system -->
    <body name="box" pos="0.5 0.5 0.5">
      <joint name="box_free" type="free"/>
      <geom name="box_geom" type="box" size="0.1 0.1 0.1" rgba="0.7 0.7 0.7 1"/>
    </body>
  </worldbody>
</mujoco>
