<?xml version="1.0"?>
<!--
Aider 机器人主 xacro 文件。

标准 ROS2 做法：用 xacro 包装 URDF，便于参数化与模块化。
当前 aider.urdf 为 SolidWorks 导出（28 关节，含 mesh），
本文件通过 xacro:include 直接引入，保留原始结构的同时提供标准入口。

用法:
    ros2 launch robot_description display.launch.py
    或直接: xacro urdf/aider/aider.urdf.xacro > /tmp/aider.urdf
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aider">

  <!-- 机器人命名空间前缀（多机时用于区分） -->
  <xacro:arg name="prefix" default=""/>

  <!-- 引入 SolidWorks 导出的完整模型（含 28 关节与 mesh 引用） -->
  <xacro:include filename="$(find robot_description)/urdf/aider/aider.urdf"/>

</robot>
